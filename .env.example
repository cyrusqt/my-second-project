# Copy this file to .env for local `vercel dev`, and add the same
# values in Vercel Project Settings -> Environment Variables for prod.

# Resend API key (Resend dashboard -> API Keys). Server-side only.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives contact form submissions.
CONTACT_TO_EMAIL=clauron.king@gmail.com

# Verified sender address. Until you verify a domain in Resend, you can
# only use onboarding@resend.dev, and it can only deliver to the email
# on your Resend account.
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
